<Project>
    <PropertyGroup>
        <!-- Target Framework e Versione Linguaggio -->
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>

        <!-- Sicurezza e Qualità del Codice -->
        <TreatWarningsAsErrors Condition="'$(Configuration)' == 'Release'">true</TreatWarningsAsErrors>
        <AnalysisLevel>latest-recommended</AnalysisLevel>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
        <Deterministic>true</Deterministic>

        <!-- Soppressione avvisi vulnerabilità pacchetti transitivi preview -->
        <NoWarn>$(NoWarn);NU1901;NU1902;NU1903;NU1904</NoWarn>

        <!-- Metadati Progetto -->
        <Authors>Dose Architecture Team</Authors>
        <Company>Dose Private Club</Company>
        <Product>Dose - Bar &amp; Drinking Tracker</Product>
        <Copyright>Copyright © 2026</Copyright>
    </PropertyGroup>

    <!-- Abilita gli interni per i progetti di test -->
    <ItemGroup>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
            <_Parameter1>Dose.UnitTests</_Parameter1>
        </AssemblyAttribute>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
            <_Parameter1>Dose.IntegrationTests</_Parameter1>
        </AssemblyAttribute>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
            <_Parameter1>DynamicProxyGenAssembly2</_Parameter1>
        </AssemblyAttribute>
    </ItemGroup>
</Project>